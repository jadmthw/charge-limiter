<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChargeLimiter.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="ChargeLimiter.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="760"
        Height="780"
        MinWidth="580"
        MinHeight="600"
        Title="Charge Limiter"
        Background="#E8EEF2">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#F7FAFC" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #1A0F2A3A" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0F766E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#D9E4EC" />
      <Setter Property="Foreground" Value="#0F172A" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Window.Styles>

  <Panel>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#D7E6EF" Offset="0" />
          <GradientStop Color="#E8EEF2" Offset="0.5" />
          <GradientStop Color="#CFE8E2" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <ScrollViewer Padding="24">
      <StackPanel Spacing="14" MaxWidth="700" HorizontalAlignment="Center">

        <StackPanel Spacing="4">
          <TextBlock Text="Charge Limiter" FontSize="28" FontWeight="Bold" Foreground="#0F172A" />
          <TextBlock Text="Latitude 7455 · pure-software ~80% care"
                     FontSize="14" Foreground="#475569" />
        </StackPanel>

        <Border IsVisible="{Binding IsLoading}" Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding StatusHeadline}" FontWeight="SemiBold" FontSize="18" />
            <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#475569" />
            <ProgressBar IsIndeterminate="True" Height="4" Foreground="#0F766E" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding !IsLoading}" Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding StatusHeadline}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" Foreground="#334155" />
            <TextBlock Text="{Binding BatteryText}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FirmwareText}" TextWrapping="Wrap" Foreground="#475569" />
            <Button Classes="secondary" Content="Refresh status" Command="{Binding RefreshCommand}" />
          </StackPanel>
        </Border>

        <!-- Soft cap — flagship -->
        <Border Classes="card" IsVisible="{Binding !IsLoading}" BorderBrush="#0F766E" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Soft cap (works on this device)" FontSize="17" FontWeight="Bold" Foreground="#0F766E" />
            <TextBlock Text="When on AC and battery reaches your target (default 80%), Charge Limiter notifies you — or sleeps/hibernates. Rearms below the low threshold or when unplugged. This does not stop the charger in firmware; it stops you from idling at 100%."
                       TextWrapping="Wrap" Foreground="#334155" />

            <CheckBox Content="Enable soft cap monitor" IsChecked="{Binding SoftCapEnabled}" />
            <CheckBox Content="Run Charge Limiter at Windows logon (HKCU Run)" IsChecked="{Binding RunAtLogin}" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Target %" FontSize="12" Foreground="#64748B" />
                <NumericUpDown Minimum="50" Maximum="100" Value="{Binding TargetPercent}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Rearm %" FontSize="12" Foreground="#64748B" />
                <NumericUpDown Minimum="40" Maximum="99" Value="{Binding RearmPercent}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                <TextBlock Text="Poll seconds" FontSize="12" Foreground="#64748B" />
                <NumericUpDown Minimum="10" Maximum="600" Value="{Binding PollSeconds}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                <TextBlock Text="Action at target" FontSize="12" Foreground="#64748B" />
                <ComboBox ItemsSource="{Binding ActionChoices}" SelectedIndex="{Binding SelectedActionIndex}" />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Save &amp; start" Command="{Binding SaveSoftCapCommand}" />
              <Button Classes="secondary" Content="Poll now" Command="{Binding TickSoftCapNowCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding SoftCapHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SoftCapLive}" TextWrapping="Wrap" Foreground="#0F766E" />
            <TextBlock Text="{Binding SoftCapDetail}" TextWrapping="Wrap" Foreground="#475569" FontSize="12" />

            <Border IsVisible="{Binding HasSoftCapMessage}" Background="#F1F5F9" CornerRadius="8" Padding="10">
              <StackPanel Spacing="2">
                <TextBlock Text="Saved" IsVisible="{Binding SoftCapMessageOk}" FontWeight="SemiBold" Foreground="#047857" />
                <TextBlock Text="Could not save" IsVisible="{Binding !SoftCapMessageOk}" FontWeight="SemiBold" Foreground="#B91C1C" />
                <TextBlock Text="{Binding SoftCapMessage}" TextWrapping="Wrap" Foreground="#0F172A" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding !IsLoading}">
          <StackPanel Spacing="6">
            <TextBlock Text="Windows / OEM Smart Charging probe" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding SmartChargingText}" TextWrapping="Wrap" Foreground="#334155" FontSize="12" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding !IsLoading}">
          <StackPanel Spacing="6">
            <TextBlock Text="Dell BIOS attributes (charge-related first)" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding BiosReport}" TextWrapping="Wrap" Foreground="#334155" FontSize="12" />
            <TextBlock Text="Dell WMI / cctk probes" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding ProbeLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#334155" FontSize="12" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding PlatformNote}" TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="4,0,4,16" />
      </StackPanel>
    </ScrollViewer>
  </Panel>
</Window>
